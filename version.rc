#define VS_VERSION_INFO 1
#define VOS_NT_WINDOWS32 0x00040004L
#define VFT_APP 0x00000001L
#define VFT2_UNKNOWN 0x00000000L

1 ICON "Resources\\app.ico"

1 VERSIONINFO
FILEVERSION 2,2,0,0
PRODUCTVERSION 2,2,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "RoxasSmithSolutions"
            VALUE "FileDescription", "Mass Effect Andromeda Basic Save Editor"
            VALUE "FileVersion", "2.2.0.0"
            VALUE "InternalName", "ME Andromeda Basic Save Editor.exe"
            VALUE "LegalCopyright", "RoxasSmithSolutions"
            VALUE "OriginalFilename", "ME Andromeda Basic Save Editor.exe"
            VALUE "ProductName", "Mass Effect Andromeda Basic Save Editor"
            VALUE "ProductVersion", "2.2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
