<Window x:Class="MEABasicSaveEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ME Andromeda Basic Save Editor"
        Height="920" Width="1280"
        MinHeight="920" MinWidth="1280"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#080D14" Foreground="#E2E8F0"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <!-- Futuristic Mass Effect Andromeda Theme Brushes -->
        <SolidColorBrush x:Key="AccentColor" Color="#00D2FF"/>
        <SolidColorBrush x:Key="AccentHover" Color="#33DDFF"/>
        <SolidColorBrush x:Key="MenuBarBg" Color="#E60D1622"/>
        <SolidColorBrush x:Key="TitleBarBg" Color="#D9111B29"/>
        <SolidColorBrush x:Key="CardBg" Color="#A60A131F"/>
        <SolidColorBrush x:Key="CardHeaderBg" Color="#E6101E2E"/>
        <SolidColorBrush x:Key="BorderColor" Color="#253E5C"/>
        <SolidColorBrush x:Key="BorderFocus" Color="#00D2FF"/>
        <SolidColorBrush x:Key="InputBg" Color="#CC0D1722"/>
        <SolidColorBrush x:Key="TextNormal" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9AB2D1"/>

        <!-- Custom ToolBar Buttons -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#162538"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#253E5C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#203650"/>
                    <Setter Property="BorderBrush" Value="#00D2FF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#007799"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#00D2FF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0099C2"/>
                    <Setter Property="BorderBrush" Value="#33DDFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SavePrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0E5A8A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#00D2FF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1374B0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#4A181E"/>
            <Setter Property="Foreground" Value="#FFAAA6"/>
            <Setter Property="BorderBrush" Value="#7E242C"/>
            <Setter Property="Padding" Value="6,2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#6E232B"/>
                    <Setter Property="BorderBrush" Value="#FF5A65"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Mini Action Button Style -->
        <Style x:Key="MiniBtnStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="#17273A"/>
            <Setter Property="BorderBrush" Value="#22405F"/>
            <Setter Property="Foreground" Value="#00D2FF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#1E3652"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#00E5FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#0A1828"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <!-- Category Pill Button Style for Armory -->
        <!-- Category Pill Styles: Unique Distinct Colors for each category -->
        <!-- Weapons (Amber Orange) -->
        <Style x:Key="PillWeapons" TargetType="RadioButton">
            <Setter Property="Background" Value="#18110A"/>
            <Setter Property="Foreground" Value="#FFA726"/>
            <Setter Property="BorderBrush" Value="#42260C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D1C0A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF9100"/>
                                <Setter Property="Foreground" Value="#FFB74D"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#381D05"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF9100"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                                <Setter Property="Foreground" Value="#FF9100"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Weapon Mods (Emerald Green) -->
        <Style x:Key="PillWeaponMods" TargetType="RadioButton">
            <Setter Property="Background" Value="#0A1C14"/>
            <Setter Property="Foreground" Value="#69F0AE"/>
            <Setter Property="BorderBrush" Value="#13472C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#113524"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00E676"/>
                                <Setter Property="Foreground" Value="#B9F6CA"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#06381C"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00E676"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                                <Setter Property="Foreground" Value="#00E676"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Armor (Shield Cyan / Blue) -->
        <Style x:Key="PillArmor" TargetType="RadioButton">
            <Setter Property="Background" Value="#0B1A2A"/>
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="BorderBrush" Value="#163854"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#122E4A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00D2FF"/>
                                <Setter Property="Foreground" Value="#7DD3FC"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#082A47"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00D2FF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                                <Setter Property="Foreground" Value="#00D2FF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fusion Mods (Exotic Violet / Purple) -->
        <Style x:Key="PillFusionMods" TargetType="RadioButton">
            <Setter Property="Background" Value="#1A0D23"/>
            <Setter Property="Foreground" Value="#E879F9"/>
            <Setter Property="BorderBrush" Value="#421A58"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A1239"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C084FC"/>
                                <Setter Property="Foreground" Value="#F0ABFC"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#38104F"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C084FC"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                                <Setter Property="Foreground" Value="#C084FC"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Consumables (Golden Yellow) -->
        <Style x:Key="PillConsumables" TargetType="RadioButton">
            <Setter Property="Background" Value="#1C1808"/>
            <Setter Property="Foreground" Value="#FBBF24"/>
            <Setter Property="BorderBrush" Value="#4A3E10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E260A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FBBF24"/>
                                <Setter Property="Foreground" Value="#FDE68A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#382E06"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FBBF24"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                                <Setter Property="Foreground" Value="#FBBF24"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Form TextBoxes -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextNormal}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#00D2FF"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BorderFocus}"/>
                </Trigger>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                    <Setter Property="Background" Value="#0A121A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TabControl and TabItem Styles -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Tab Header Buttons using StackPanel so WPF TabPanel arrange hack does not clip bottom border -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12" IsItemsHost="True"/>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Background" Value="#0E1724"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#192A3D"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#2A5C85"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#0C2033"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="1.5"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Toggle Button Template -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" 
                    BorderThickness="{TemplateBinding BorderThickness}" 
                    CornerRadius="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="22" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1" Background="#142132" BorderBrush="{StaticResource BorderColor}" BorderThickness="1,0,0,0" CornerRadius="0,2,2,0">
                        <Path HorizontalAlignment="Center" 
                              VerticalAlignment="Center" 
                              Data="M 0 0 L 4 4 L 8 0 Z" 
                              Fill="{StaticResource AccentColor}" />
                    </Border>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentColor}" />
                    <Setter TargetName="ButtonBorder" Property="Background" Value="#1C2E42" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Custom Dark Andromeda ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0D1826" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}" 
                                          Focusable="False" 
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press" />
                            <ContentPresenter x:Name="ContentSite" 
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              TextElement.Foreground="#FFFFFF"
                                              Margin="10,4,28,4" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left" />
                            <Popup x:Name="Popup" 
                                   Placement="Bottom" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown" 
                                      SnapsToDevicePixels="True" 
                                      MinWidth="{TemplateBinding ActualWidth}" 
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" 
                                            Background="#0E1928" 
                                            BorderThickness="1" 
                                            BorderBrush="{StaticResource AccentColor}" 
                                            CornerRadius="3" />
                                    <ScrollViewer Margin="2,4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="95" />
                            </Trigger>
                            <Trigger Property="IsGrouping" Value="True">
                                <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#0E1928" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1A3450" />
                                <Setter Property="Foreground" Value="#00D2FF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#0F4777" />
                                <Setter Property="Foreground" Value="#00D2FF" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Andromeda Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HorizontalGridLinesBrush" Value="Transparent"/>
            <Setter Property="RowBackground" Value="#9909131F"/>
            <Setter Property="AlternatingRowBackground" Value="#BF0D1826"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="RowHeight" Value="34"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource CardHeaderBg}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{StaticResource TextNormal}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#172A3D"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1F364E"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#14324F"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container with Background Image Overlay -->
    <Grid>
        <!-- Background sci-fi nebula overlay -->
        <Image Source="Resources/background.jpg" Stretch="UniformToFill" Opacity="0.40" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0. Top Menu Bar -->
                <RowDefinition Height="Auto"/> <!-- 1. Active File Header Strip -->
                <RowDefinition Height="Auto"/> <!-- 2. Notification Banner -->
                <RowDefinition Height="*"/>    <!-- 3. Tabbed Content -->
                <RowDefinition Height="Auto"/> <!-- 4. Status Footer -->
            </Grid.RowDefinitions>

            <!-- 1. TOP MENU BAR -->
            <Border Grid.Row="0" Background="{StaticResource MenuBarBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="12,6">
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Image Source="Resources/emblem.png" Height="26" Width="40" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="ME Andromeda Basic Save Editor" FontWeight="Bold" Foreground="{StaticResource AccentColor}" FontSize="14" VerticalAlignment="Center" Margin="0,0,20,0"/>

                        <!-- Action Buttons -->
                        <Button Content="📂 Open Save..." Click="BtnOpenFile_Click" Style="{StaticResource AccentButton}" Margin="0,0,6,0" ToolTip="Open a save file to edit."/>
                        <Button x:Name="BtnSave" Content="💾 Save" Click="BtnSave_Click" Style="{StaticResource SavePrimaryButton}" IsEnabled="False" Margin="0,0,6,0" ToolTip="Creates a timestamped backup in 'ME Andromeda Save Editor Backup' and saves all edits directly to your game save."/>
                        <Button x:Name="BtnReload" Content="↻ Reload" Click="BtnReload_Click" IsEnabled="False" Margin="0,0,14,0" ToolTip="Reload the active save from disk"/>

                        <Button Content="↺ Restore from Backup..." Click="BtnRestoreBackup_Click" Margin="0,0,6,0" ToolTip="View and restore timestamped backups"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnAbout" Click="BtnAbout_Click" Margin="0,0,4,0" Height="28" Cursor="Hand" ToolTip="About ME Andromeda Save Editor, How-To Guides &amp; License">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#091624"/>
                                    <Setter Property="Foreground" Value="#00D2FF"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#1C3852" BorderThickness="1" CornerRadius="3">
                                                    <Grid>
                                                        <Border Width="3" HorizontalAlignment="Left" Background="#00D2FF" CornerRadius="3,0,0,3"/>
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,4,10,4"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#143450"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#00D2FF"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        <Setter TargetName="Bd" Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect BlurRadius="12" Color="#00D2FF" Opacity="0.7" ShadowDepth="0"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#005B7F"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#55E6FF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="◈" FontWeight="Bold" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="ABOUT" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 2. ACTIVE FILE HEADER STRIP -->
            <Border Grid.Row="1" Background="{StaticResource TitleBarBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="14,6">
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="FILE:" Foreground="{StaticResource TextMuted}" FontWeight="Bold" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtHeaderFileName" Text="None (Editor is blank)" Foreground="{StaticResource AccentColor}" FontWeight="Bold" FontSize="11" Margin="0,0,18,0" VerticalAlignment="Center"/>

                        <TextBlock Text="PATHFINDER:" Foreground="{StaticResource TextMuted}" FontWeight="Bold" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtHeaderPathfinder" Text="--" Foreground="{StaticResource TextNormal}" FontSize="11" Margin="0,0,18,0" VerticalAlignment="Center"/>

                        <TextBlock Text="LEVEL:" Foreground="{StaticResource TextMuted}" FontWeight="Bold" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtHeaderLevel" Text="--" Foreground="{StaticResource TextNormal}" FontSize="11" Margin="0,0,18,0" VerticalAlignment="Center"/>

                        <TextBlock Text="PLAYTIME:" Foreground="{StaticResource TextMuted}" FontWeight="Bold" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtHeaderPlaytime" Text="--" Foreground="{StaticResource TextNormal}" FontSize="11" Margin="0,0,18,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 3. NOTIFICATION BANNER -->
            <Border Grid.Row="2" x:Name="BannerAlert" Visibility="Collapsed" Background="#0C3B24" BorderBrush="#2ECC71" BorderThickness="0,0,0,1" Padding="12,5">
                <DockPanel LastChildFill="True">
                    <TextBlock x:Name="TxtAlertMessage" Text="✓ Action completed successfully." FontWeight="SemiBold" Foreground="#2ECC71" FontSize="11" VerticalAlignment="Center"/>
                    <Button Content="✕" Click="BtnDismissAlert_Click" DockPanel.Dock="Right" HorizontalAlignment="Right" Background="Transparent" Foreground="#A0D0B0" BorderThickness="0" Cursor="Hand" Padding="6,0"/>
                </DockPanel>
            </Border>

            <!-- 4. MAIN CONTENT AREA (TABBED) -->
            <Grid Grid.Row="3">
                <!-- Initial Welcome Prompt (Visible when no save is loaded) -->
                <Border x:Name="PanelWelcomePrompt" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="30" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="Resources/emblem.png" Height="48" Width="70" Margin="0,0,0,16" HorizontalAlignment="Center"/>
                        <TextBlock Text="No save file is currently open." FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextNormal}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Click '📂 Open Save...' above to select an Andromeda save file from your BioWare Save folder." FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,6,0,16"/>
                        <Button Content="📂 Open Save File" Click="BtnOpenFile_Click" Style="{StaticResource AccentButton}" Padding="18,7" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- TAB CONTROL -->
                <TabControl x:Name="MainTabs" Visibility="Collapsed" Margin="14,10,14,10">
                    
                    <!-- ============================================================== -->
                    <!-- TAB 1: GENERAL                                                 -->
                    <!-- ============================================================== -->
                    <TabItem Header="⚙ General">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="4,10,4,16">

                                <!-- Row 1: Role-Play & Campaign -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- ROLE-PLAY CARD -->
                                    <Border Grid.Column="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0">
                                        <StackPanel>
                                            <Border Background="{StaticResource CardHeaderBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="10,6" CornerRadius="3,3,0,0">
                                                <TextBlock Text="Role-Play" FontWeight="Bold" Foreground="{StaticResource AccentColor}" FontSize="13"/>
                                            </Border>
                                            <Grid Margin="12,8,12,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Pathfinder Name:" VerticalAlignment="Center" Margin="0,3"/>
                                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtPathfinderName" Margin="0,2"/>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Pathfinder Identity:" VerticalAlignment="Center" Margin="0,3"/>
                                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtPathfinderIdentity" Margin="0,2" IsReadOnly="True" 
                                                         Background="#0B1522" Foreground="#94A3B8"
                                                         ToolTip="Campaign Pathfinder identity (Scott or Sara Ryder). Fixed by the game engine for this career."/>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Active Profile / Training:" VerticalAlignment="Center" Margin="0,3"/>
                                                <Grid Grid.Row="2" Grid.Column="1" Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" x:Name="TxtActiveProfileDisplay" IsReadOnly="True" 
                                                             Background="#0B1522" Foreground="#00D2FF" FontWeight="SemiBold" 
                                                             BorderBrush="{StaticResource BorderColor}" 
                                                             ToolTip="Ryder's active combat profile. Change this by clicking 'Set Active' on the Profiles tab."/>
                                                    <Button Grid.Column="1" Content="Switch Profile &#x279C;" Click="BtnGoToProfiles_Click" 
                                                            Style="{StaticResource MiniBtnStyle}" Margin="6,0,0,0" Padding="8,2" Height="24"
                                                            ToolTip="Open the Profiles tab to choose Ryder's active combat profile"/>
                                                </Grid>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- CAMPAIGN CARD -->
                                    <Border Grid.Column="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Margin="6,0,0,0">
                                        <StackPanel>
                                            <Border Background="{StaticResource CardHeaderBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="10,6" CornerRadius="3,3,0,0">
                                                <TextBlock Text="Campaign" FontWeight="Bold" Foreground="{StaticResource AccentColor}" FontSize="13"/>
                                            </Border>
                                            <Grid Margin="12,8,12,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Play Time:" VerticalAlignment="Center" Margin="0,3"/>
                                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtPlayTime" Margin="0,2" IsReadOnly="True"/>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Current Location:" VerticalAlignment="Center" Margin="0,3"/>
                                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtLocation" Margin="0,2" IsReadOnly="True"/>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Difficulty:" VerticalAlignment="Center" Margin="0,3"/>
                                                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CmbDifficulty" Margin="0,2">
                                                    <ComboBoxItem Content="Narrative"/>
                                                    <ComboBoxItem Content="Casual"/>
                                                    <ComboBoxItem Content="Normal"/>
                                                    <ComboBoxItem Content="Hardcore"/>
                                                    <ComboBoxItem Content="Insanity"/>
                                                </ComboBox>

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Career ID:" VerticalAlignment="Center" Margin="0,3"/>
                                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtCareerId" Margin="0,2" IsReadOnly="True"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Row 2: Split Gameplay (Left) & Progression (Right) -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- GAMEPLAY CARD -->
                                    <Border Grid.Column="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0">
                                        <StackPanel>
                                            <Border Background="{StaticResource CardHeaderBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="10,6" CornerRadius="3,3,0,0">
                                                <TextBlock Text="Gameplay" FontWeight="Bold" Foreground="{StaticResource AccentColor}" FontSize="13"/>
                                            </Border>
                                            <Grid Margin="12,8,12,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Ryder Level:" VerticalAlignment="Center" Margin="0,3"/>
                                                <Grid Grid.Row="0" Grid.Column="1" Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" x:Name="TxtRyderLevel" ToolTip="Ryder Level (1-132). Raising level automatically grants spendable skill points in-game (+6 SP per level)."/>
                                                    <Button Grid.Column="1" x:Name="BtnAddLevel" Content="+5 Levels (+30 SP)" Click="BtnAddLevel_Click" 
                                                            Style="{StaticResource MiniBtnStyle}" Margin="6,0,0,0" Padding="8,2" Height="24"
                                                            ToolTip="Advance Ryder by 5 levels to immediately unlock 30 skill points in-game"/>
                                                </Grid>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Current XP:" VerticalAlignment="Center" Margin="0,3"/>
                                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtCurrentXp" Margin="0,2" ToolTip="Total current experience points. Synchronized with Ryder Level."/>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Unspent Skill Points:" VerticalAlignment="Center" Margin="0,3"/>
                                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtSkillPoints" Margin="0,2" IsReadOnly="True" 
                                                         Background="#0B1522" Foreground="#94A3B8"
                                                         ToolTip="In Andromeda, skill points are calculated dynamically by the game from your Ryder Level (+6 SP per level). Raise Ryder Level or click '+5 Levels' to gain spendable points!"/>

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Item Limit:" VerticalAlignment="Center" Margin="0,3"/>
                                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtItemLimit" TextChanged="TxtItemLimit_TextChanged" Margin="0,2" ToolTip="Inventory item capacity (Default 100, Trade Capacity I: 150, Trade Capacity II: 200)"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- PROGRESSION CARD -->
                                    <Border Grid.Column="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Margin="6,0,0,0">
                                        <StackPanel>
                                            <Border Background="{StaticResource CardHeaderBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="10,6" CornerRadius="3,3,0,0">
                                                <TextBlock Text="Progression" FontWeight="Bold" Foreground="{StaticResource AccentColor}" FontSize="13"/>
                                            </Border>
                                            <Grid Margin="12,8,12,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Nexus Level:" VerticalAlignment="Center" Margin="0,3"/>
                                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtNexusLevel" Margin="0,2" ToolTip="Current Nexus Station Level (1-30)"/>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Current A.V.P.:" VerticalAlignment="Center" Margin="0,3"/>
                                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtAvpPoints" Margin="0,2" ToolTip="Andromeda Viability Points"/>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Credits:" VerticalAlignment="Center" Margin="0,3"/>
                                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtCredits" Margin="0,2"/>

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Milky Way Research:" VerticalAlignment="Center" Margin="0,3"/>
                                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtMilkyWayRD" Margin="0,2"/>

                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Heleus Research:" VerticalAlignment="Center" Margin="0,3"/>
                                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtHeleusRD" Margin="0,2"/>

                                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Remnant Research:" VerticalAlignment="Center" Margin="0,3"/>
                                                <TextBox Grid.Row="5" Grid.Column="1" x:Name="TxtRemnantRD" Margin="0,2"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ============================================================== -->
                    <!-- TAB 2: ARMORY                                                  -->
                    <!-- ============================================================== -->
                    <TabItem Header="⚔ Armory">
                        <Grid Margin="4,10,4,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Category Tabs & Search Bar -->
                                <RowDefinition Height="*"/>    <!-- DataGrid of Inventory Items -->
                                <RowDefinition Height="Auto"/> <!-- Add Item Panel -->
                            </Grid.RowDefinitions>

                            <!-- Top Controls: Category Pill Navigation, Sub-category Filter & Search -->
                            <Border Grid.Row="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,10">
                                <DockPanel LastChildFill="True">
                                    <!-- Right: SubCategory, Search Box, Clear & Count in View -->
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="14,0,0,0">
                                        <TextBlock Text="Sub-Type:" Foreground="{StaticResource TextMuted}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="CmbArmorySubCategory" Width="125" SelectionChanged="CmbArmorySubCategory_SelectionChanged" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                        <TextBlock Text="&#x1F50D; Search:" Foreground="{StaticResource TextMuted}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="TxtArmorySearch" Width="125" TextChanged="TxtArmorySearch_TextChanged" VerticalAlignment="Center" Margin="0,0,4,0" ToolTip="Type to search items in current category"/>
                                        <Button Content="&#x2715;" Click="BtnClearArmorySearch_Click" Style="{StaticResource MiniBtnStyle}" Width="22" Height="22" Padding="0" Margin="0,0,10,0" ToolTip="Clear search"/>

                                        <Border Background="#0C1B2B" BorderBrush="#1C3854" BorderThickness="1" CornerRadius="3" Padding="8,3" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtArmoryCount" Text="0 in View" Foreground="#00D2FF" FontWeight="Bold" FontSize="11"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Left: Category Navigation Pill Buttons with individual color identities -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton x:Name="RbFilterWeapons" Content="&#x1F52B; Weapons" IsChecked="True" Checked="FilterArmoryCategory_Changed" GroupName="ArmoryCat" Style="{StaticResource PillWeapons}" Margin="0,0,5,0"/>
                                        <RadioButton x:Name="RbFilterWeaponMods" Content="&#x2699; Weapon Mods" Checked="FilterArmoryCategory_Changed" GroupName="ArmoryCat" Style="{StaticResource PillWeaponMods}" Margin="0,0,5,0"/>
                                        <RadioButton x:Name="RbFilterArmor" Content="&#x1F6E1; Armor" Checked="FilterArmoryCategory_Changed" GroupName="ArmoryCat" Style="{StaticResource PillArmor}" Margin="0,0,5,0"/>
                                        <RadioButton x:Name="RbFilterFusionMods" Content="&#x1F52E; Fusion Mods" Checked="FilterArmoryCategory_Changed" GroupName="ArmoryCat" Style="{StaticResource PillFusionMods}" Margin="0,0,5,0"/>
                                        <RadioButton x:Name="RbFilterConsumables" Content="&#x26A1; Consumables" Checked="FilterArmoryCategory_Changed" GroupName="ArmoryCat" Style="{StaticResource PillConsumables}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <!-- DataGrid of Inventory Items with futuristic loadout styling -->
                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <DataGrid x:Name="DgArmoryItems" RowHeight="46">
                                    <DataGrid.Columns>
                                        <!-- Category Badge -->
                                        <DataGridTemplateColumn Header="Type" Width="95">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="#142233" BorderBrush="{Binding CategoryColor}" BorderThickness="1" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0">
                                                        <TextBlock Text="{Binding CategoryTag}" Foreground="{Binding CategoryColor}" FontWeight="Bold" FontSize="10"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Item Name & Partition Resource -->
                                        <DataGridTemplateColumn Header="Item Name" Width="*" MinWidth="320" SortMemberPath="DisplayName">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Center" Margin="4,2">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="{StaticResource TextNormal}" FontSize="12"/>
                                                        <TextBlock Text="{Binding FriendlySubtitle}" Foreground="{StaticResource TextMuted}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Editable Rarity Dropdown -->
                                        <DataGridTemplateColumn Header="Rarity" Width="120" SortMemberPath="Rarity">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox SelectedIndex="{Binding RarityIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Width="105" Height="25" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <ComboBoxItem Content="Common" Foreground="#94A3B8"/>
                                                        <ComboBoxItem Content="Uncommon" Foreground="#93C5FD"/>
                                                        <ComboBoxItem Content="Rare" Foreground="#FCD34D"/>
                                                        <ComboBoxItem Content="Ultra Rare" Foreground="#D8B4FE"/>
                                                    </ComboBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Editable Tier Dropdown -->
                                        <DataGridTemplateColumn Header="Tier" Width="110" SortMemberPath="Tier">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <ComboBox Visibility="{Binding HasTier, Converter={StaticResource BoolToVisConverter}}"
                                                                  SelectedIndex="{Binding TierIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  Width="90" Height="25" VerticalAlignment="Center">
                                                            <ComboBoxItem Content="Tier I"/>
                                                            <ComboBoxItem Content="Tier II"/>
                                                            <ComboBoxItem Content="Tier III"/>
                                                            <ComboBoxItem Content="Tier IV"/>
                                                            <ComboBoxItem Content="Tier V"/>
                                                            <ComboBoxItem Content="Tier VI"/>
                                                            <ComboBoxItem Content="Tier VII"/>
                                                            <ComboBoxItem Content="Tier VIII"/>
                                                            <ComboBoxItem Content="Tier IX"/>
                                                            <ComboBoxItem Content="Tier X"/>
                                                        </ComboBox>
                                                        <TextBlock Visibility="{Binding NoTier, Converter={StaticResource BoolToVisConverter}}"
                                                                   Text="--" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Quantity Stepper -->
                                        <DataGridTemplateColumn Header="Quantity" Width="140" SortMemberPath="Quantity">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Button Content="-" Click="BtnArmoryQtyDown_Click" Style="{StaticResource MiniBtnStyle}" Width="22" Height="22" Padding="0" Margin="0,0,4,0" ToolTip="Decrease quantity"/>
                                                        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="55" HorizontalContentAlignment="Center" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <Button Content="+" Click="BtnArmoryQtyUp_Click" Style="{StaticResource MiniBtnStyle}" Width="22" Height="22" Padding="0" ToolTip="Increase quantity"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Actions (Delete) -->
                                        <DataGridTemplateColumn Header="Actions" Width="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="🗑 Remove" Click="BtnDeleteArmoryItem_Click" Style="{StaticResource DangerButton}" ToolTip="Remove this item from your save game"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Empty State Indicator -->
                                <Border x:Name="PanelArmoryEmpty" Background="#B3080D14" CornerRadius="4" Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
