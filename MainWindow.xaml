                                            <TextBlock Text="• Augmentations &amp; Salvage: Search and customize all 47 weapon/armor crafting modules." Foreground="{StaticResource TextMuted}" FontSize="11.5" Margin="0,0,0,8"/>

                                            <!-- Screenshot Preview -->
                                            <Border BorderBrush="#1C2E42" BorderThickness="1" CornerRadius="3" Background="#050B13" Padding="2" HorizontalAlignment="Center">
                                                <Image Source="Resources/guide_resources.png" MaxHeight="220" Stretch="Uniform"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Step 6 -->
                                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="16,12">
                                        <StackPanel>
                                            <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                                <Border Background="#10B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="3" Padding="8,2" DockPanel.Dock="Right">
                                                    <TextBlock Text="STEP 6" Foreground="#09131F" FontWeight="Bold" FontSize="10"/>
                                                </Border>
                                                <TextBlock Text="💾 Step 6: Save Your Game &amp; Automated Safety Backups" FontWeight="Bold" Foreground="#10B981" FontSize="13"/>
                                            </DockPanel>
                                            <TextBlock Text="1. Click '💾 Save' in the top menu bar whenever you are ready to write changes." Foreground="{StaticResource TextNormal}" FontSize="11.5" Margin="0,0,0,2"/>
