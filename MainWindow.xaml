                                                <TextBlock Text="📂 Step 1: Open Your Save File" FontWeight="Bold" Foreground="#00D2FF" FontSize="13"/>
                                            </DockPanel>
                                            <TextBlock Text="1. Click '📂 Open Save...' in the top menu bar." Foreground="{StaticResource TextNormal}" FontSize="11.5" Margin="0,0,0,2"/>
