                                                <Border Background="#1A3450" BorderBrush="#00D2FF" BorderThickness="1" CornerRadius="3" Padding="8,2" DockPanel.Dock="Right">
                                                    <TextBlock Text="STEP 5" Foreground="#00D2FF" FontWeight="Bold" FontSize="10"/>
                                                </Border>
                                                <TextBlock Text="📦 Step 5: Crafting Supplies &amp; Decryption Keys (Resources Tab)" FontWeight="Bold" Foreground="#00D2FF" FontSize="13"/>
