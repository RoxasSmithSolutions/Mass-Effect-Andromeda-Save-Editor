<Window x:Class="MEABasicSaveEditor.RestoreBackupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restore from Safety Backup - ME Andromeda Basic Save Editor"
        Height="580" Width="800"
        MinHeight="450" MinWidth="650"
        WindowStartupLocation="CenterOwner"
        Background="#0B111A" Foreground="#E2E8F0"
        FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentColor" Color="#00D2FF"/>
        <SolidColorBrush x:Key="AccentHover" Color="#33DDFF"/>
        <SolidColorBrush x:Key="CardBg" Color="#101924"/>
        <SolidColorBrush x:Key="CardHeaderBg" Color="#162334"/>
        <SolidColorBrush x:Key="BorderColor" Color="#1E334D"/>
        <SolidColorBrush x:Key="InputBg" Color="#0F1A26"/>
        <SolidColorBrush x:Key="TextNormal" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8FA3BF"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#172638"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#253E5C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#223954"/>
                    <Setter Property="BorderBrush" Value="#00D2FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RestoreActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#007799"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#00D2FF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0099C2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox Toggle Button Template -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="22" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" 
                        CornerRadius="3" 
                        Background="{StaticResource InputBg}" 
                        BorderBrush="{StaticResource BorderColor}" 
                        BorderThickness="1" />
                <Border Grid.Column="0" Margin="1" Background="Transparent" />
                <Path x:Name="Arrow" Grid.Column="1" 
                      HorizontalAlignment="Center" VerticalAlignment="Center" 
                      Data="M 0 0 L 4 4 L 8 0 Z" 
                      Fill="{StaticResource AccentColor}" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentColor}" />
                    <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextNormal}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentColor}"/>
                                <Setter Property="Foreground" Value="#0A0F15"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentHover}"/>
                                <Setter Property="Foreground" Value="#0A0F15"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Form ComboBoxes -->
        <Style TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource TextNormal}" />
            <Setter Property="Background" Value="{StaticResource InputBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}" 
                                          Focusable="False" 
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press" />
                            <ContentPresenter x:Name="ContentSite" 
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              TextElement.Foreground="{StaticResource TextNormal}"
                                              Margin="8,3,25,3" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left" />
                            <Popup x:Name="Popup" 
                                   Placement="Bottom" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown" 
                                      SnapsToDevicePixels="True" 
                                      MinWidth="{TemplateBinding ActualWidth}" 
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" 
                                            Background="#142132" 
                                            BorderThickness="1" 
                                            BorderBrush="{StaticResource AccentColor}" 
                                            CornerRadius="3" />
                                    <ScrollViewer Margin="2,4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#101924"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1E334D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#101924"/>
            <Setter Property="AlternatingRowBackground" Value="#131F2E"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#1A2D42"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#162334"/>
                        <Setter Property="Foreground" Value="#00D2FF"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="BorderBrush" Value="#1E334D"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Target Live Save Card -->
            <RowDefinition Height="Auto"/> <!-- Subtitle -->
            <RowDefinition Height="*"/>    <!-- Backup Grid -->
            <RowDefinition Height="Auto"/> <!-- Bottom bar -->
        </Grid.RowDefinitions>

        <!-- Top Header Banner -->
        <Border Grid.Row="0" Background="{StaticResource CardHeaderBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="📁 Open Backup Folder" Click="BtnOpenFolder_Click" Margin="0,0,6,0"/>
                    <Button Content="↻ Refresh List" Click="BtnRefresh_Click"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
                    <TextBlock Text="Safety Backups Manager" FontWeight="Bold" Foreground="{StaticResource AccentColor}" FontSize="15"/>
                    <TextBlock Text="Backups location: %USERPROFILE%\Documents\ME Andromeda Save Editor Backup" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 1. Target Live Game Save Selection -->
        <Border Grid.Row="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="1. Target Live Game Save to Overwrite:" FontWeight="Bold" Foreground="{StaticResource AccentColor}" FontSize="13"/>
                    <TextBlock Text="The restored backup values will load into the editor, and clicking '💾 Save' will overwrite this file in your game folder:" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
                <ComboBox Grid.Row="1" x:Name="CmbTargetLiveSave" Height="28" DisplayMemberPath="DisplayName"/>
            </Grid>
        </Border>

        <!-- 2. Section Subtitle -->
        <TextBlock Grid.Row="2" Text="2. Select a backup to load into the editor:" FontWeight="Bold" Foreground="{StaticResource AccentColor}" Margin="2,0,0,6"/>

        <!-- Backups List -->
        <DataGrid Grid.Row="3" x:Name="DgBackups" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Original Save File" Binding="{Binding OriginalSaveName}" Width="220" FontWeight="Bold"/>
                <DataGridTextColumn Header="Backup Date &amp; Time" Binding="{Binding FormattedDate}" Width="160"/>
                <DataGridTextColumn Header="File Size" Binding="{Binding FormattedSize}" Width="90"/>
                <DataGridTemplateColumn Header="Action" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="↺ Load Backup into Editor" Style="{StaticResource RestoreActionButton}" Click="BtnRestoreItem_Click" Tag="{Binding}" HorizontalAlignment="Left" Padding="12,3" Margin="4,2" ToolTip="Load all values from this backup into the editor so you can review and save to the live game file."/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Bottom Controls -->
        <Border Grid.Row="4" Margin="0,12,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="TxtBackupCount" Text="0 backup(s) found" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="Cancel / Close" Click="BtnClose_Click" Padding="16,5"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
